[
  {"id": 1, "texto": "avanzá 2 metros", "intencion_esperada": "MOVER", "resultado_esperado": "EJECUTAR", "params_esperados": {"distancia_m": 2.0}},
  {"id": 2, "texto": "detente ya", "intencion_esperada": "DETENERSE", "resultado_esperado": "EJECUTAR", "params_esperados": {}},
  {"id": 3, "texto": "saluda a los estudiantes", "intencion_esperada": "SALUDO", "resultado_esperado": "EJECUTAR", "params_esperados": {}},
  {"id": 4, "texto": "girá 90 grados a la derecha", "intencion_esperada": "GIRAR", "resultado_esperado": "EJECUTAR", "params_esperados": {"angulo_deg": 90, "direccion": "derecha"}},
  {"id": 5, "texto": "¿cuánta batería tenés?", "intencion_esperada": "CONSULTAR_ESTADO", "resultado_esperado": "EJECUTAR", "params_esperados": {}},
  {"id": 6, "texto": "avanzá 100 metros", "intencion_esperada": "MOVER", "resultado_esperado": "BLOQUEADO", "motivo": "distancia > máximo"},
  {"id": 7, "texto": "salta desde la mesa", "intencion_esperada": "DESCONOCIDO", "resultado_esperado": "BLOQUEADO", "motivo": "palabra peligrosa"},
  {"id": 8, "texto": "muévete a 2 m/s", "intencion_esperada": "MOVER", "resultado_esperado": "BLOQUEADO", "motivo": "velocidad > máximo"},
  {"id": 9, "texto": "hola, ¿cómo te llamás?", "intencion_esperada": "DESCONOCIDO", "resultado_esperado": "DESCONOCIDO", "motivo": "fuera de dominio"},
  {"id": 10, "texto": "no avances", "intencion_esperada": "DETENERSE", "resultado_esperado": "EJECUTAR", "params_esperados": {}},
  {"id": 11, "texto": "caminá despacio hacia adelante", "intencion_esperada": "MOVER", "resultado_esperado": "EJECUTAR", "params_esperados": {"velocidad_ms": 0.2}},
  {"id": 12, "texto": "girá a la izquierda", "intencion_esperada": "GIRAR", "resultado_esperado": "EJECUTAR", "params_esperados": {"direccion": "izquierda"}},
  {"id": 13, "texto": "pará todo", "intencion_esperada": "DETENERSE", "resultado_esperado": "EJECUTAR", "params_esperados": {}},
  {"id": 14, "texto": "avanzá rápido 3 metros", "intencion_esperada": "MOVER", "resultado_esperado": "EJECUTAR", "params_esperados": {"distancia_m": 3.0, "velocidad_ms": 0.5}},
  {"id": 15, "texto": "media vuelta", "intencion_esperada": "GIRAR", "resultado_esperado": "EJECUTAR", "params_esperados": {"angulo_deg": 180}},
  {"id": 16, "texto": "retrocedé un poco", "intencion_esperada": "MOVER", "resultado_esperado": "EJECUTAR", "params_esperados": {}},
  {"id": 17, "texto": "empujá la caja", "intencion_esperada": "DESCONOCIDO", "resultado_esperado": "BLOQUEADO", "motivo": "palabra peligrosa"},
  {"id": 18, "texto": "¿cómo estás de batería?", "intencion_esperada": "CONSULTAR_ESTADO", "resultado_esperado": "EJECUTAR", "params_esperados": {}},
  {"id": 19, "texto": "girá 270 grados", "intencion_esperada": "GIRAR", "resultado_esperado": "BLOQUEADO", "motivo": "ángulo > 180"},
  {"id": 20, "texto": "corré lo más rápido que puedas", "intencion_esperada": "DESCONOCIDO", "resultado_esperado": "BLOQUEADO", "motivo": "palabra peligrosa"},
  {"id": 21, "texto": "andá para atrás 1 metro", "intencion_esperada": "MOVER", "resultado_esperado": "EJECUTAR", "params_esperados": {"distancia_m": 1.0}},
